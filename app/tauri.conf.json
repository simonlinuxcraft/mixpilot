{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixpilot",
  "version": "0.0.1",
  "identifier": "io.github.simonlinuxcraft.mixpilot",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mixpilot",
        "width": 1000,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 720,
        "create": false,
        "decorations": false,
        "backgroundColor": "#111316"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Music",
    "shortDescription": "Mixer, sound and microphone control for PipeWire",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/mixpilot/mixpilot-core": "../core/target/release/mixpilot-core"
        }
      }
    }
  }
}
